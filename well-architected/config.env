# Shared by create.sh and create.ps1.
# KEY=VALUE only. No quotes, no spaces. Lines starting with # are comments.
# A variable already set in the environment wins over this file.

REGION=us-east-1
NAME=wa
ENV=prd

VPC_NAME=wa-vpc
VPC_CIDR=10.0.0.0/16
PUBLIC_CIDR_1=10.0.0.0/24
PUBLIC_CIDR_2=10.0.1.0/24
PRIVATE_CIDR_1=10.0.10.0/24
PRIVATE_CIDR_2=10.0.11.0/24
ISOLATED_CIDR_1=10.0.20.0/24
ISOLATED_CIDR_2=10.0.21.0/24

INSTANCE_TYPE=t3.micro
# Empty means "use the current public IP /32".
BASTION_SSH_CIDR=
